# Example: Coding project — R2R instance configuration
# Copy to .env and customize.
COMPOSE_PROJECT_NAME=r2r-coding
INSTANCE=coding

# Ports (offset from TTRPG by 1000)
R2R_PORT=8272
DASHBOARD_PORT=8273
GRAPH_CLUSTERING_PORT=8276

# R2R project name — creates an isolated Postgres schema
R2R_PROJECT_NAME=coding_assistant

# Config file (relative to instances/coding/user_configs/)
R2R_CONFIG_FILE=config.toml
