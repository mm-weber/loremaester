# TTRPG Obsidian Vault — R2R instance configuration
COMPOSE_PROJECT_NAME=r2r-ttrpg
INSTANCE=ttrpg

# Ports
R2R_PORT=7272
DASHBOARD_PORT=7273
GRAPH_CLUSTERING_PORT=7276

# R2R project name — creates an isolated Postgres schema
R2R_PROJECT_NAME=ttrpg_vault

# Config file (relative to instances/ttrpg/user_configs/)
R2R_CONFIG_FILE=r2r-ollama-embeddings.toml
