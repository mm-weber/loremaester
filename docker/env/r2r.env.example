# R2R API server (Light Mode). Loaded by the `r2r` service in docker/compose.yaml.
#
# Copy this file to `r2r.env` and edit if you need to change the defaults:
#   cp docker/env/r2r.env.example docker/env/r2r.env
#
# Light Mode runs R2R with built-in ingestion + simple (in-process)
# orchestration — no Hatchet, RabbitMQ, or Unstructured.io. With the
# Ollama-embeddings-only TOML, Claude Code handles all reasoning via MCP, so
# no provider API keys (OpenAI, Anthropic, etc.) are needed.

# --- Server bind -------------------------------------------------------------
R2R_HOST=0.0.0.0
R2R_PORT=7272
# Where R2R looks for user-defined tools. Matches the ./user_tools bind mount.
R2R_USER_TOOLS_PATH=/app/user_tools

# --- Config selection --------------------------------------------------------
# R2R_CONFIG_NAME (built-in preset) and R2R_CONFIG_PATH (custom TOML) are
# mutually exclusive — leave _NAME empty when using _PATH.
# docker/user_configs/ is bind-mounted to /app/user_configs/ in compose.yaml.
R2R_CONFIG_NAME=
R2R_CONFIG_PATH=/app/user_configs/r2r-light.toml

# --- Postgres ----------------------------------------------------------------
# Must match the credentials in postgres.env.
R2R_POSTGRES_USER=postgres
R2R_POSTGRES_PASSWORD=postgres
R2R_POSTGRES_HOST=postgres
R2R_POSTGRES_PORT=5432
R2R_POSTGRES_DBNAME=postgres

# Isolated schema name inside the Postgres database.
R2R_PROJECT_NAME=r2r_default

# --- Embeddings --------------------------------------------------------------
# Ollama runs on the host; the container reaches it via the docker host bridge.
OLLAMA_API_BASE=http://host.docker.internal:11434
