# PostgreSQL for R2R (pgvector/pgvector:pg16).
# Loaded by the `postgres` service in compose.full.yaml (active when `--profile postgres` is passed).
#
# Copy this file to `postgres.env` and edit if you need non-default credentials.
#   cp docker/env/postgres.env.example docker/env/postgres.env
#
# These credentials are for local development only — change them for any shared
# or production deployment. They must stay in sync with R2R_POSTGRES_USER /
# R2R_POSTGRES_PASSWORD / R2R_POSTGRES_DBNAME in r2r-full.env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
