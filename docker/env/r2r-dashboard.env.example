# R2R dashboard (Next.js app, exposed at http://localhost:7273).
# Loaded by the `r2r-dashboard` service in compose.full.yaml.
#
# Copy this file to `r2r-dashboard.env` and edit if you change the default ports.
#   cp docker/env/r2r-dashboard.env.example docker/env/r2r-dashboard.env
#
# These URLs are rendered into the browser-side bundle (NEXT_PUBLIC_*), so they
# must be reachable from your browser — localhost is usually correct.

NEXT_PUBLIC_R2R_DEPLOYMENT_URL=http://localhost:7272
NEXT_PUBLIC_HATCHET_DASHBOARD_URL=http://localhost:7274

# Default dashboard login. Change these for any non-local deployment — they are
# visible in the rendered HTML bundle and should not protect real data.
NEXT_PUBLIC_R2R_DEFAULT_EMAIL=admin@example.com
NEXT_PUBLIC_R2R_DEFAULT_PASSWORD=change_me_immediately
