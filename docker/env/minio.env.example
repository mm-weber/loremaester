# Minio object storage. Loaded by the `minio` service in compose.full.yaml.
#
# The minio service only starts when you pass `--profile minio` to docker compose,
# so this file is not required for the default quickstart flow
# (`--profile postgres` only). Provide it if you plan to enable minio.
#
# Copy this file to `minio.env` and edit if you need non-default credentials.
#   cp docker/env/minio.env.example docker/env/minio.env

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
