# R2R API server. Loaded by the `r2r` service in compose.full.yaml.
#
# Copy this file to `r2r-full.env` and edit if you need to change the defaults.
#   cp docker/env/r2r-full.env.example docker/env/r2r-full.env
#
# With the provided Ollama-embeddings-only TOML config, Claude Code handles all
# LLM work via MCP — R2R does not need any provider API keys (OpenAI, Anthropic,
# etc.) populated.

# --- Server bind -------------------------------------------------------------
# Consumed by docker/scripts/start-r2r.sh as `uvicorn --host $R2R_HOST --port
# $R2R_PORT`. The script has no defaults, so unset values would crash uvicorn.
R2R_HOST=0.0.0.0
R2R_PORT=7272
# Where R2R looks for user-defined tools. Matches the `./user_tools:/app/user_tools`
# bind mount in compose.full.yaml.
R2R_USER_TOOLS_PATH=/app/user_tools

# --- Config selection --------------------------------------------------------
# R2R picks its config from either R2R_CONFIG_NAME (built-in preset) OR
# R2R_CONFIG_PATH (path to a custom TOML). They are mutually exclusive — leave
# _NAME empty when using _PATH.
#
# docker/user_configs/ is bind-mounted into the container at /app/user_configs/.
R2R_CONFIG_NAME=
R2R_CONFIG_PATH=/app/user_configs/r2r-ollama-embeddings.toml

# --- Postgres ----------------------------------------------------------------
# Must match the credentials in postgres.env.
R2R_POSTGRES_USER=postgres
R2R_POSTGRES_PASSWORD=postgres
R2R_POSTGRES_HOST=postgres
R2R_POSTGRES_PORT=5432
R2R_POSTGRES_DBNAME=postgres

# Isolated schema name inside the shared Postgres database.
R2R_PROJECT_NAME=r2r_default

# --- Embeddings --------------------------------------------------------------
# Ollama runs on the host; the container reaches it via the docker host bridge.
OLLAMA_API_BASE=http://host.docker.internal:11434

# --- Cross-service URLs (default compose network) ----------------------------
UNSTRUCTURED_SERVICE_URL=http://unstructured:7275
CLUSTERING_SERVICE_URL=http://graph_clustering:7276

# --- Hatchet -----------------------------------------------------------------
# TLS disabled for the local deployment. HATCHET_CLIENT_TOKEN is read at
# runtime from the hatchet_api_key shared volume — do not set it here.
HATCHET_CLIENT_TLS_STRATEGY=none
