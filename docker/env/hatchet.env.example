# Hatchet orchestrator. Shared by 7 services in compose.full.yaml:
#   hatchet-postgres, hatchet-rabbitmq, hatchet-create-db, hatchet-migration,
#   hatchet-setup-config, hatchet-engine, hatchet-dashboard.
#
# Copy this file to `hatchet.env` and edit if you need non-default credentials.
#   cp docker/env/hatchet.env.example docker/env/hatchet.env
#
# All services share this file because they must agree on how to reach the same
# hatchet-postgres instance. Change credentials for any non-local deployment.

# Hatchet's internal Postgres — separate from R2R's Postgres.
# Consumed by the hatchet-postgres image.
POSTGRES_USER=hatchet_user
POSTGRES_PASSWORD=hatchet_password
POSTGRES_DB=hatchet

# Same values, under the names docker/scripts/create-hatchet-db.sh reads.
HATCHET_POSTGRES_USER=hatchet_user
HATCHET_POSTGRES_PASSWORD=hatchet_password
HATCHET_POSTGRES_DBNAME=hatchet

# RabbitMQ — Hatchet's task queue.
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password

# DATABASE_URL — used by hatchet-migration, hatchet-setup-config, hatchet-engine, hatchet-dashboard.
DATABASE_URL=postgres://hatchet_user:hatchet_password@hatchet-postgres:5432/hatchet?sslmode=disable

# hatchet-setup-config needs the split-out Postgres vars in addition to DATABASE_URL.
DATABASE_POSTGRES_PORT=5432
DATABASE_POSTGRES_HOST=hatchet-postgres
DATABASE_POSTGRES_USERNAME=hatchet_user
DATABASE_POSTGRES_PASSWORD=hatchet_password
HATCHET_DATABASE_POSTGRES_DB_NAME=hatchet

# Hatchet server config — connects engine to RabbitMQ and wires the cookie/URL for the dashboard.
SERVER_TASKQUEUE_RABBITMQ_URL=amqp://user:password@hatchet-rabbitmq:5672/
SERVER_AUTH_COOKIE_DOMAIN=http://host.docker.internal:7274
SERVER_URL=http://host.docker.internal:7274
SERVER_AUTH_COOKIE_INSECURE=t
SERVER_GRPC_BIND_ADDRESS=0.0.0.0
SERVER_GRPC_INSECURE=t
SERVER_GRPC_BROADCAST_ADDRESS=hatchet-engine:7077
SERVER_GRPC_MAX_MSG_SIZE=134217728

# 128 MB gRPC message limits — large enough for full PDF chunk batches.
HATCHET_CLIENT_GRPC_MAX_RECV_MESSAGE_LENGTH=134217728
HATCHET_CLIENT_GRPC_MAX_SEND_MESSAGE_LENGTH=134217728
